CREATE TABLE IF NOT EXISTS EntryEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,
    category_id INTEGER,
    description TEXT,
    account_id INTEGER NOT NULL,
    amount INTEGER NOT NULL,
    to_account_id INTEGER,
    to_amount INTEGER,
    created_at INTEGER NOT NULL,
    created_zone TEXT NOT NULL
);

insert:
INSERT INTO EntryEntity (
    type, category_id, description, account_id, amount,
    to_account_id, to_amount, created_at, created_zone
)
VALUES (:type, :categoryId, :description, :accountId, :amount,
        :toAccountId, :toAmount, :createdAt, :createdZone);

insertWithId:
INSERT INTO EntryEntity (
    id, type, category_id, description, account_id, amount,
    to_account_id, to_amount, created_at, created_zone
)
VALUES (:id, :type, :categoryId, :description, :accountId, :amount,
        :toAccountId, :toAmount, :createdAt, :createdZone);

-- Raw rows only; used to serialize the database into a backup.
selectAllRows:
SELECT *
FROM EntryEntity;

selectAll:
SELECT EntryEntity.id,
       EntryEntity.type,
       EntryEntity.category_id AS categoryId,
       EntryEntity.description,
       EntryEntity.account_id AS accountId,
       EntryEntity.amount,
       EntryEntity.to_account_id AS toAccountId,
       EntryEntity.to_amount AS toAmount,
       EntryEntity.created_at AS createdAt,
       EntryEntity.created_zone AS createdZone,
       AccountEntity.name AS accountName,
       AccountEntity.currency AS accountCurrency,
       CategoryEntity.name AS categoryName,
       CategoryEntity.type AS categoryType,
       ToAccountEntity.name AS toAccountName,
       ToAccountEntity.currency AS toAccountCurrency
FROM EntryEntity
JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
LEFT JOIN CategoryEntity ON CategoryEntity.id = EntryEntity.category_id
LEFT JOIN AccountEntity AS ToAccountEntity ON ToAccountEntity.id = EntryEntity.to_account_id
ORDER BY EntryEntity.id DESC;

selectSince:
SELECT EntryEntity.id,
       EntryEntity.type,
       EntryEntity.category_id AS categoryId,
       EntryEntity.description,
       EntryEntity.account_id AS accountId,
       EntryEntity.amount,
       EntryEntity.to_account_id AS toAccountId,
       EntryEntity.to_amount AS toAmount,
       EntryEntity.created_at AS createdAt,
       EntryEntity.created_zone AS createdZone,
       AccountEntity.name AS accountName,
       AccountEntity.currency AS accountCurrency,
       CategoryEntity.name AS categoryName,
       CategoryEntity.type AS categoryType,
       ToAccountEntity.name AS toAccountName,
       ToAccountEntity.currency AS toAccountCurrency
FROM EntryEntity
JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
LEFT JOIN CategoryEntity ON CategoryEntity.id = EntryEntity.category_id
LEFT JOIN AccountEntity AS ToAccountEntity ON ToAccountEntity.id = EntryEntity.to_account_id
WHERE EntryEntity.created_at >= :epochMs
ORDER BY EntryEntity.created_at DESC, EntryEntity.id DESC;

selectSinceByType:
SELECT EntryEntity.id,
       EntryEntity.type,
       EntryEntity.category_id AS categoryId,
       EntryEntity.description,
       EntryEntity.account_id AS accountId,
       EntryEntity.amount,
       EntryEntity.to_account_id AS toAccountId,
       EntryEntity.to_amount AS toAmount,
       EntryEntity.created_at AS createdAt,
       EntryEntity.created_zone AS createdZone,
       AccountEntity.name AS accountName,
       AccountEntity.currency AS accountCurrency,
       CategoryEntity.name AS categoryName,
       CategoryEntity.type AS categoryType,
       ToAccountEntity.name AS toAccountName,
       ToAccountEntity.currency AS toAccountCurrency
FROM EntryEntity
JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
LEFT JOIN CategoryEntity ON CategoryEntity.id = EntryEntity.category_id
LEFT JOIN AccountEntity AS ToAccountEntity ON ToAccountEntity.id = EntryEntity.to_account_id
WHERE EntryEntity.type = :type AND EntryEntity.created_at >= :epochMs
ORDER BY EntryEntity.created_at DESC, EntryEntity.id DESC;

selectLatestByType:
SELECT EntryEntity.id,
       EntryEntity.type,
       EntryEntity.category_id AS categoryId,
       EntryEntity.description,
       EntryEntity.account_id AS accountId,
       EntryEntity.amount,
       EntryEntity.to_account_id AS toAccountId,
       EntryEntity.to_amount AS toAmount,
       EntryEntity.created_at AS createdAt,
       EntryEntity.created_zone AS createdZone,
       AccountEntity.name AS accountName,
       AccountEntity.currency AS accountCurrency,
       CategoryEntity.name AS categoryName,
       CategoryEntity.type AS categoryType,
       ToAccountEntity.name AS toAccountName,
       ToAccountEntity.currency AS toAccountCurrency
FROM EntryEntity
JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
LEFT JOIN CategoryEntity ON CategoryEntity.id = EntryEntity.category_id
LEFT JOIN AccountEntity AS ToAccountEntity ON ToAccountEntity.id = EntryEntity.to_account_id
WHERE EntryEntity.type = :type
ORDER BY EntryEntity.created_at DESC, EntryEntity.id DESC
LIMIT 1;

selectUpTo:
SELECT EntryEntity.id,
       EntryEntity.type,
       EntryEntity.category_id AS categoryId,
       EntryEntity.description,
       EntryEntity.account_id AS accountId,
       EntryEntity.amount,
       EntryEntity.to_account_id AS toAccountId,
       EntryEntity.to_amount AS toAmount,
       EntryEntity.created_at AS createdAt,
       EntryEntity.created_zone AS createdZone,
       AccountEntity.name AS accountName,
       AccountEntity.currency AS accountCurrency,
       CategoryEntity.name AS categoryName,
       CategoryEntity.type AS categoryType,
       ToAccountEntity.name AS toAccountName,
       ToAccountEntity.currency AS toAccountCurrency
FROM EntryEntity
JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
LEFT JOIN CategoryEntity ON CategoryEntity.id = EntryEntity.category_id
LEFT JOIN AccountEntity AS ToAccountEntity ON ToAccountEntity.id = EntryEntity.to_account_id
WHERE EntryEntity.created_at <= :epochMs
ORDER BY EntryEntity.created_at DESC, EntryEntity.id DESC;

deleteById:
DELETE FROM EntryEntity WHERE id = :id;

updateById:
UPDATE EntryEntity
SET type = :type,
    category_id = :categoryId,
    description = :description,
    account_id = :accountId,
    amount = :amount,
    to_account_id = :toAccountId,
    to_amount = :toAmount,
    created_at = :createdAt,
    created_zone = :createdZone
WHERE id = :id;

deleteAll:
DELETE FROM EntryEntity;

-- Accounts referenced by at least one entry, as source or transfer target.
-- Their currency must not be changed while entries exist.
accountsWithEntries:
SELECT DISTINCT accountId
FROM (
    SELECT EntryEntity.account_id AS accountId
    FROM EntryEntity
    UNION ALL
    SELECT EntryEntity.to_account_id AS accountId
    FROM EntryEntity
    WHERE EntryEntity.to_account_id IS NOT NULL
);

-- Net change per account in the account's own currency: income adds, expenses
-- and transfers subtract from the source; the transfer target gains the received
-- amount (or the sent amount for same-currency transfers).
accountDeltas:
SELECT accountId, COALESCE(SUM(delta), 0) AS delta
FROM (
    SELECT EntryEntity.account_id AS accountId,
           CASE
               WHEN EntryEntity.type = 'Income' THEN EntryEntity.amount
               ELSE -EntryEntity.amount
           END AS delta
    FROM EntryEntity
    UNION ALL
    SELECT EntryEntity.to_account_id AS accountId,
           COALESCE(EntryEntity.to_amount, EntryEntity.amount) AS delta
    FROM EntryEntity
    WHERE EntryEntity.type = 'Transfer'
)
GROUP BY accountId;

-- Net total per category and entry currency (transfers excluded), so FX
-- conversion can happen once per currency group instead of per entry.
categoryTotals:
SELECT categoryId, currency, COALESCE(SUM(net), 0) AS net
FROM (
    SELECT EntryEntity.category_id AS categoryId,
           AccountEntity.currency AS currency,
           CASE
               WHEN EntryEntity.type = 'Income' THEN EntryEntity.amount
               ELSE -EntryEntity.amount
           END AS net
    FROM EntryEntity
    JOIN AccountEntity ON AccountEntity.id = EntryEntity.account_id
    WHERE EntryEntity.type != 'Transfer'
)
GROUP BY categoryId, currency;
