CREATE TABLE IF NOT EXISTS CpiEntity (
    currency TEXT NOT NULL,
    month TEXT NOT NULL,
    indexValue INTEGER NOT NULL,
    PRIMARY KEY (currency, month)
);

selectAll:
SELECT *
FROM CpiEntity
ORDER BY currency ASC, month ASC;

selectByCurrency:
SELECT *
FROM CpiEntity
WHERE currency = ?
ORDER BY month ASC;

insertOrReplace:
INSERT OR REPLACE INTO CpiEntity (currency, month, indexValue)
VALUES (?, ?, ?);

countAll:
SELECT COUNT(*)
FROM CpiEntity;
