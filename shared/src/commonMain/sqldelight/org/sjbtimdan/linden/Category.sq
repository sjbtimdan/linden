CREATE TABLE IF NOT EXISTS CategoryEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    icon TEXT
);

insert:
INSERT INTO CategoryEntity (name, type, icon)
VALUES (?, ?, ?);

insertWithId:
INSERT INTO CategoryEntity (id, name, type, icon)
VALUES (?, ?, ?, ?);

update:
UPDATE CategoryEntity
SET name = ?, type = ?, icon = ?
WHERE id = ?;

selectAll:
SELECT *
FROM CategoryEntity
ORDER BY name ASC;

deleteById:
DELETE FROM CategoryEntity
WHERE id = ?;

deleteAll:
DELETE FROM CategoryEntity;
