CREATE TABLE IF NOT EXISTS AccountEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    currency TEXT NOT NULL,
    initialBalance INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT INTO AccountEntity (name, currency, initialBalance)
VALUES (?, ?, ?);

insertWithId:
INSERT INTO AccountEntity (id, name, currency, initialBalance)
VALUES (?, ?, ?, ?);

update:
UPDATE AccountEntity
SET name = ?, currency = ?, initialBalance = ?
WHERE id = ?;

updateInitialBalance:
UPDATE AccountEntity
SET initialBalance = ?
WHERE id = ?;

selectAll:
SELECT *
FROM AccountEntity
ORDER BY name ASC;

selectByName:
SELECT *
FROM AccountEntity
WHERE name = ?
LIMIT 1;

deleteById:
DELETE FROM AccountEntity WHERE id = ?;

deleteAll:
DELETE FROM AccountEntity;
