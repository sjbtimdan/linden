CREATE TABLE IF NOT EXISTS FxRateEntity (
    baseCurrency TEXT NOT NULL,
    quoteCurrency TEXT NOT NULL,
    rate REAL NOT NULL,
    date TEXT NOT NULL,
    fetchedAt INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (baseCurrency, quoteCurrency)
);

selectByBase:
SELECT *
FROM FxRateEntity
WHERE baseCurrency = ?
ORDER BY quoteCurrency ASC;

selectAll:
SELECT *
FROM FxRateEntity;

insertOrReplace:
INSERT OR REPLACE INTO FxRateEntity (baseCurrency, quoteCurrency, rate, date, fetchedAt)
VALUES (?, ?, ?, ?, ?);

selectFetchedAtByBase:
SELECT fetchedAt
FROM FxRateEntity
WHERE baseCurrency = ?
LIMIT 1;

deleteByBase:
DELETE FROM FxRateEntity
WHERE baseCurrency = ?;
